{
  "expo": {
    "name": "OpenVoz Mobile",
    "slug": "openvoz-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "openvoz-mobile",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openvoz.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "openVozApi": {
        "defaultEnvironment": "development",
        "environments": {
          "development": {
            "label": "Development",
            "siteUrl": "http://192.168.100.132:8000",
            "apiBaseUrl": "http://192.168.100.132:8000/api/v1",
            "versionPath": "/api/version/"
          },
          "staging": {
            "label": "Staging",
            "siteUrl": "https://staging.openvoz.com",
            "apiBaseUrl": "https://staging.openvoz.com/api/v1",
            "connectivityPath": "/usersvoicechat/login/",
            "versionPath": "/api/version/"
          },
          "production": {
            "label": "Production",
            "siteUrl": "https://www.openvoz.com",
            "apiBaseUrl": "https://www.openvoz.com/api/v1",
            "connectivityPath": "/usersvoicechat/login/",
            "versionPath": "/api/version/"
          }
        }
      },
      "router": {},
      "eas": {
        "projectId": "fa079bb3-27c2-45ee-a262-7145a16edc7d"
      }
    }
  }
}
